# Backend environment variables — copy to backend/.env and fill in real values
# NEVER commit .env — only this example file is committed

APP_ENV=local
API_KEY=change-me
STORE_BACKEND=memory
GCP_PROJECT_ID=
GCP_REGION=asia-south1
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_CODE=gpt-4o
GITHUB_TOKEN=
GITHUB_OWNER=
TARGET_REPO=secureflow-demo-target
TARGET_BASE_BRANCH=main
SUPPORTED_LANGUAGES=py
MAX_CONCURRENT_RUNS=3
MAX_TOTAL_RUNS=100
MAX_FIX_ATTEMPTS=2
SANDBOX_TIMEOUT_SECONDS=60
MAX_PATCH_CHANGED_LINES=80
FRONTEND_ORIGIN=http://localhost:3000
